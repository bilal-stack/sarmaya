# Copy to .env for local development. Never commit the result — .env is
# gitignored, and this file exists so the shape is documented without the
# values.

# --- Database ----------------------------------------------------------------
# The app's own connection. MUST be a non-superuser, non-BYPASSRLS role: a
# superuser silently bypasses every row-level security policy, which would
# leave tenant isolation resting on the application layer alone.
DATABASE_URL=postgresql://os_app:password@localhost:5432/os
# Used only by Alembic for DDL. May be the table owner or a superuser; the
# running app must never use it.
ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/os

# --- Security ----------------------------------------------------------------
# Every access token is signed with this. Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the repository's placeholder unless DEBUG is on.
SECRET_KEY=generate-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Whether strangers may sign themselves into a tenant by naming its slug. Off:
# even at the default clerk role a self-registered user can create vendors,
# raise invoices, prepare payment runs and import bank statements.
ALLOW_SELF_REGISTRATION=false

# --- Environment -------------------------------------------------------------
# true only on a developer machine. When on, the 500 handler includes the
# exception type and message, and the startup checks on SECRET_KEY and
# CORS_ORIGINS are skipped.
DEBUG=true

# Comma-separated, or a JSON array. Must be the frontend's real origin in any
# deployed environment — the app refuses to start if it still says localhost
# while DEBUG is off.
CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002

# --- AI (optional) -----------------------------------------------------------
# Nothing here is required to run the app; the AI features degrade to their
# rule-based fallbacks without keys.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- OCR (optional) ----------------------------------------------------------
OCR_PROVIDER=ocr_space
OCR_SPACE_API_KEY=
# Google Document AI, if used instead
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=
