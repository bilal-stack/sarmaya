# Copy to .env for local development. Never commit the result — .env is
# gitignored, and this file exists so the shape is documented without the
# values.

# --- Database ----------------------------------------------------------------
# The app's own connection. MUST be a non-superuser, non-BYPASSRLS role: a
# superuser silently bypasses every row-level security policy, which would
# leave tenant isolation resting on the application layer alone.
DATABASE_URL=postgresql://os_app:password@localhost:5432/os
# Used only by Alembic for DDL. May be the table owner or a superuser; the
# running app must never use it.
ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:5432/os

# --- Security ----------------------------------------------------------------
# Every access token is signed with this. Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the repository's placeholder unless DEBUG is on.
SECRET_KEY=generate-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Whether strangers may sign themselves into a tenant by naming its slug. Off:
# even at the default clerk role a self-registered user can create vendors,
# raise invoices, prepare payment runs and import bank statements.
ALLOW_SELF_REGISTRATION=false

# --- Environment -------------------------------------------------------------
# true only on a developer machine. When on, the 500 handler includes the
# exception type and message, and the startup checks on SECRET_KEY and
# CORS_ORIGINS are skipped.
DEBUG=true

# Comma-separated, or a JSON array. Must be the frontend's real origin in any
# deployed environment — the app refuses to start if it still says localhost
# while DEBUG is off.
CORS_ORIGINS=http://localhost:9002,http://127.0.0.1:9002

# --- AI (optional) -----------------------------------------------------------
# Nothing here is required to run the app; the AI features degrade to their
# rule-based fallbacks without keys.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- OCR (optional) ----------------------------------------------------------
OCR_PROVIDER=ocr_space
OCR_SPACE_API_KEY=
# Google Document AI, if used instead
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Notification email ------------------------------------------------------
# Notifications (approvals, SLA escalations, watchlist alerts) are queued in the
# same transaction as the action that produced them and delivered afterwards by
# a scheduler. Two things are needed in production, and mail is silent without
# BOTH of them:
#
#   1. SMTP_ENABLED=true and the SMTP_* settings below.
#      While this is false, messages are HELD untouched rather than attempted,
#      so switching it on later sends the backlog rather than finding it
#      expired. Nothing is lost by leaving it off; nothing is delivered either.
#
#   2. A scheduler running the drain, every minute is fine and it is cheap when
#      the queue is empty:
#
#          python -m scripts.dispatch_notifications
#
#      Without it, messages queue forever and nobody is ever told anything.
#      Render blueprint: see the "sarmaya-notifications" cron service.
#
# Check it is working after a deploy:
#   GET /api/v1/notifications/queue/summary   (needs workflow.manage)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
# Seconds. Kept short because a slow mail server should not stall the drain.
SMTP_TIMEOUT=5


# --- Workflow timers ---------------------------------------------------------
# Two jobs that only happen if something runs them:
#
#   * reminders   — nudge whoever can act on an item that is waiting but not
#                   yet late, so the escalation never has to fire
#   * escalations — when an SLA is breached, tell the escalation role once
#
#       python -m scripts.run_workflow_timers      (hourly is plenty)
#
# Escalation previously fired only when an admin clicked "Escalate overdue" in
# the Decision Inbox. Render blueprint: the "sarmaya-workflow-timers" service.
#
# How long an item may sit before a nudge, and the minimum gap between nudges:
REMINDER_INTERVAL_HOURS=24
# How far into the item's own SLA the nudge fires, as a fraction of it. A fixed
# delay cannot work — it has to be shorter than the deadline it protects, and
# the deadlines differ per state.
REMINDER_AT_SLA_FRACTION=0.5


# --- AI routing --------------------------------------------------------------
# Which models run which kind of task, cheapest first. Format:
#   provider:model, provider:model
# The second entry is the fallback, tried only when the first fails schema
# validation or comes back under-confident — so the stronger model costs
# nothing on the common path.
#
# Leave empty to use AI_PROVIDER for everything, which is how the system
# behaved before routing existed.
#
#   AI_ROUTE_EXTRACTION=gemini:gemini-2.5-flash, claude:claude-opus-4-8
#   AI_ROUTE_CLASSIFICATION=gemini:gemini-2.5-flash, claude:claude-opus-4-8
#   AI_ROUTE_REASONING=claude:claude-opus-4-8
AI_ROUTE_EXTRACTION=
AI_ROUTE_CLASSIFICATION=
AI_ROUTE_REASONING=

# Below this confidence a response is treated as a failure and the next
# candidate is tried.
AI_MIN_CONFIDENCE=0.4
